{
  "name": "visioncli-linux",
  "private": true,
  "version": "0.10.2",
  "description": "VisionCLI for Linux: the voice overlay app (Electron), feature-for-feature with the macOS app.",
  "main": "build/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node build.mjs --tests && node --test $(find build/tests -name '*.test.js')",
    "start": "node build.mjs && electron .",
    "dist": "node build.mjs && electron-builder --linux AppImage deb"
  },
  "author": "The Third Sourcers",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.12",
    "typescript": "5.6"
  },
  "dependencies": {
    "dbus-next": "^0.10.2",
    "marked": "^14.1.4"
  }
}
