{
  "name": "visioncli",
  "version": "0.4.1",
  "description": "Let Claude Code see your screen: ask about the file, error, UI, table or web page you are looking at, by typing or by voice, with answers above your mouse.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && sh scripts/build-overlay.sh",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "voice": "node dist/index.js voice",
    "setup-signing": "sh scripts/setup-signing.sh",
    "release": "sh scripts/package-release.sh"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "claude",
    "screenshot",
    "screen",
    "voice",
    "macos",
    "overlay"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "visioncli": "dist/index.js"
  },
  "files": [
    "dist",
    "overlay/Sources",
    "overlay/Resources/AppIcon.icns",
    "overlay/Resources/kokoro_server.py",
    "scripts",
    "docs/logo.png",
    ".claude-plugin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "The Third Sourcers",
  "homepage": "https://github.com/thethirdsourcers/visioncli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thethirdsourcers/visioncli.git"
  },
  "bugs": {
    "url": "https://github.com/thethirdsourcers/visioncli/issues"
  }
}
