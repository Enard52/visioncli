{
  "name": "visioncli",
  "version": "0.10.1",
  "description": "AI co-assistant for developers that sees your screen and uses your Mac: ask about what you're looking at or have it do the task, by typing or voice, with Claude Code or Gemini (Antigravity).",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run typecheck && npm run bundle && sh scripts/build-overlay.sh",
    "bundle": "node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tests && node tests/run.mjs",
    "prepare": "node scripts/bundle.mjs",
    "start": "node dist/index.js",
    "voice": "node dist/index.js voice",
    "setup-signing": "sh scripts/setup-signing.sh",
    "release": "sh scripts/package-release.sh"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "claude",
    "screenshot",
    "screen",
    "voice",
    "macos",
    "overlay"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.25.12",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "visioncli": "dist/index.js"
  },
  "files": [
    "dist",
    "overlay/Sources",
    "overlay/Resources/AppIcon.icns",
    "overlay/Resources/kokoro_server.py",
    "overlay/Resources/mermaid.min.js",
    "scripts",
    "docs/logo.png",
    ".claude-plugin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "The Third Sourcers",
  "homepage": "https://github.com/thethirdsourcers/visioncli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thethirdsourcers/visioncli.git"
  },
  "bugs": {
    "url": "https://github.com/thethirdsourcers/visioncli/issues"
  }
}
