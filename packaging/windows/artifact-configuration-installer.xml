<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": the NSIS installer built from the signed app, as the GitHub
     artifact zip holding VisionCLI-<version>-windows-<arch>.exe. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="VisionCLI-*-windows-*.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
